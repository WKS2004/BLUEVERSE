{
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "coastal-operations": {
        "ClusterId": "coastal-operations",
        "Match": {
          "Path": "/api/operations/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "auth": {
            "Address": "http://auth:8080"
          }
        }
      },
      "coastal-operations": {
        "Destinations": {
          "coastal-operations": {
            "Address": "http://coastal-operations:8080"
          }
        }
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost",
      "http://localhost:5173",
      "http://localhost:8080",
      "http://localhost:3000"
    ]
  },
  "Jwt": {
    "Issuer": "Blueverse.Auth",
    "Audience": "Blueverse.Client"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*"
}
