{
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "experience-biodiversity-health": {
        "ClusterId": "experience-biodiversity",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/experiences/health"
        }
      },
      "experience-biodiversity-swagger": {
        "ClusterId": "experience-biodiversity",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/experiences/swagger/{documentName}/swagger.json"
        }
      },
      "experience-biodiversity-public-destinations-read": {
        "ClusterId": "experience-biodiversity",
        "AuthorizationPolicy": "Anonymous",
        "Order": 0,
        "Match": {
          "Path": "/api/experiences/destinations/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "experience-biodiversity-manage-destinations": {
        "ClusterId": "experience-biodiversity",
        "AuthorizationPolicy": "ExperienceCatalogueManage",
        "Order": 0,
        "Match": {
          "Path": "/api/experiences/destinations/{**catch-all}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        }
      },
      "experience-biodiversity-public-activities-read": {
        "ClusterId": "experience-biodiversity",
        "AuthorizationPolicy": "Anonymous",
        "Order": 0,
        "Match": {
          "Path": "/api/experiences/activities/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "experience-biodiversity-manage-activities": {
        "ClusterId": "experience-biodiversity",
        "AuthorizationPolicy": "ExperienceCatalogueManage",
        "Order": 0,
        "Match": {
          "Path": "/api/experiences/activities/{**catch-all}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        }
      },
      "experience-biodiversity-public-offerings-read": {
        "ClusterId": "experience-biodiversity",
        "AuthorizationPolicy": "Anonymous",
        "Order": 0,
        "Match": {
          "Path": "/api/experiences/offerings/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "experience-biodiversity-manage-offerings": {
        "ClusterId": "experience-biodiversity",
        "AuthorizationPolicy": "ExperienceCatalogueManage",
        "Order": 0,
        "Match": {
          "Path": "/api/experiences/offerings/{**catch-all}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        }
      },
      "experience-biodiversity-public-map-read": {
        "ClusterId": "experience-biodiversity",
        "AuthorizationPolicy": "Anonymous",
        "Order": 0,
        "Match": {
          "Path": "/api/experiences/map/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "experience-biodiversity-public-nearby-read": {
        "ClusterId": "experience-biodiversity",
        "AuthorizationPolicy": "Anonymous",
        "Order": 0,
        "Match": {
          "Path": "/api/experiences/nearby",
          "Methods": [ "GET" ]
        }
      },
      "experience-biodiversity-availability-evaluation": {
        "ClusterId": "experience-biodiversity",
        "AuthorizationPolicy": "ExperienceCatalogueRead",
        "Order": 0,
        "Match": {
          "Path": "/api/experiences/availability/evaluations",
          "Methods": [ "POST" ]
        }
      },
      "experience-biodiversity-favourites": {
        "ClusterId": "experience-biodiversity",
        "AuthorizationPolicy": "ExperienceAuthenticated",
        "Order": 0,
        "Match": {
          "Path": "/api/experiences/favourites/{**catch-all}",
          "Methods": [ "GET", "PUT", "DELETE" ]
        }
      },
      "experience-biodiversity": {
        "ClusterId": "experience-biodiversity",
        "AuthorizationPolicy": "ExperienceAuthenticated",
        "Order": 100,
        "Match": {
          "Path": "/api/experiences/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "auth": {
            "Address": "http://auth:8080"
          }
        }
      },
      "experience-biodiversity": {
        "Destinations": {
          "experience-biodiversity": {
            "Address": "http://experience-biodiversity:8080"
          }
        }
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost",
      "http://localhost:5173",
      "http://localhost:8080",
      "http://localhost:3000"
    ]
  },
  "Jwt": {
    "Issuer": "Blueverse.Auth",
    "Audience": "Blueverse.Client"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*"
}
