{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "Blueverse.Auth",
    "Audience": "Blueverse.Client",
    "AccessTokenMinutes": 15
  },
  "AuthSession": {
    "DefaultLifetimeDays": 1,
    "RememberMeLifetimeDays": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
