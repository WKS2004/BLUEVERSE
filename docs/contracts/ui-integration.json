    {
      "id": "coastal-operations-assessment",
      "status": "implemented",
      "description": "Separate searchable Assessment page with draft CRUD, Publish using submit, durable typed delivery, scoped activity, evidence and review. Agent delivery remains disconnected before G07. Distinct hero imagery, compact 500ms live search with local loading, read-only detail summaries and explicit Edit draft forms retain shared chrome. Evidence changes are DRAFT-only, including removal. Shared white record cards, header-aligned sticky section tabs with directional transitions, per-page cursor controls and refresh-safe query view intent; Logs-origin details suppress mutations and show correlation references only in Logs.",
      "web": {
        "route": "/operations/assessments",
        "source": "apps/web/src/app/routes.tsx"
      },
      "mobile": {
        "route": "/operations/assessments",
        "source": "apps/mobile/lib/main.dart"
      },
