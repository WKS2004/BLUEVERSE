{
  "schema": 1,
  "status": "active",
  "description": "Canonical cross-client registry for shared UI workflows, frontend routes and public API endpoint references.",
  "publicApi": {
    "gatewayPath": "/api",
    "entryService": "api",
    "forbiddenClientTargets": [
      "auth",
      "agentic-ai",
      "postgres",
      "database"
    ],
    "allowedAbsoluteHosts": [
      "localhost",
      "127.0.0.1",
      "::1",
      "10.0.2.2"
    ]
  },
  "workflows": [
    {
      "id": "foundation-home",
      "status": "starter",
      "description": "Generated starter entry surface. It has no domain API dependency yet.",
      "web": {
        "route": "/",
        "source": "apps/web/src/App.tsx"
      },
      "mobile": {
        "route": "/",
        "source": "apps/mobile/lib/main.dart"
      },
      "apiRefs": []
    },
    {
      "id": "auth-session-management",
      "status": "implemented",
      "description": "Shared sign-in and session-management workflow using protected browser cookies or Flutter secure storage.",
      "web": {
        "route": "/login",
        "source": "apps/web/src/App.tsx"
      },
      "mobile": {
        "route": "/login",
        "source": "apps/mobile/lib/main.dart"
      },
      "apiRefs": [
        "auth-login",
        "auth-refresh",
        "auth-me",
        "auth-sessions",
        "auth-logout",
        "auth-logout-all-devices"
      ]
    }
  ],
  "endpoints": [
    {
      "id": "auth-login",
      "method": "POST",
      "path": "/api/auth/login",
      "publicBoundary": "api",
      "ownerService": "auth",
      "operationId": "Login"
    },
    {
      "id": "auth-refresh",
      "method": "POST",
      "path": "/api/auth/refresh",
      "publicBoundary": "api",
      "ownerService": "auth",
      "operationId": "Refresh"
    },
    {
      "id": "auth-me",
      "method": "GET",
      "path": "/api/auth/me",
      "publicBoundary": "api",
      "ownerService": "auth",
      "operationId": "GetCurrentUser"
    },
    {
      "id": "auth-sessions",
      "method": "GET",
      "path": "/api/auth/sessions",
      "publicBoundary": "api",
      "ownerService": "auth",
      "operationId": "GetSessions"
    },
    {
      "id": "auth-logout",
      "method": "POST",
      "path": "/api/auth/logout",
      "publicBoundary": "api",
      "ownerService": "auth",
      "operationId": "Logout"
    },
    {
      "id": "auth-logout-all-devices",
      "method": "POST",
      "path": "/api/auth/logout-all-devices",
      "publicBoundary": "api",
      "ownerService": "auth",
      "operationId": "LogoutAllDevices"
    }
  ]
}
