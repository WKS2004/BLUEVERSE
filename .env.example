BLUEVERSE_HTTP_PORT=80
API_HTTP_PORT=8080
AUTH_HTTP_PORT=8080
COASTAL_PLANNER_HTTP_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# Generate a unique random value of at least 32 UTF-8 bytes and use the same
# value for the API gateway and Auth service. Never commit the real value.
JWT_SIGNING_KEY=replace-with-a-random-secret-at-least-32-characters

POSTGRES_DB=blueverse
POSTGRES_USER=blueverse
POSTGRES_PASSWORD=change-me-local

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-local-admin-password

# Docker-internal destination used by the API reverse proxy.
AUTH_SERVICE_URL=http://auth:8080
COASTAL_PLANNER_SERVICE_URL=http://coastal-planner:8080

# Auth session policy. Access JWTs are short-lived; session lifetimes are
# absolute and may be overridden only within the documented 1/30-day policy.
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_DEFAULT_SESSION_DAYS=1
AUTH_REMEMBER_ME_SESSION_DAYS=30

# Give newly registered accounts only the Coastal traveller planner role.
# Set false for deployments that require administrator assignment instead.
AUTH_SELF_SERVICE_PLANNER_ACCESS=true

# Proposed private peer contracts; these services are not part of this branch's stack.
EXPERIENCE_CATALOGUE_URL=http://experience-catalogue:8080
MARINE_CONDITIONS_URL=http://marine-conditions:8080
COASTAL_OPERATIONS_URL=http://coastal-operations:8080
BIODIVERSITY_ML_URL=http://biodiversity-ml:8080
