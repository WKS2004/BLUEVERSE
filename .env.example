BLUEVERSE_HTTP_PORT=80
API_HTTP_PORT=8080
AUTH_HTTP_PORT=8080
COASTAL_OPERATIONS_HTTP_PORT=8080
COASTAL_PLANNER_HTTP_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# Generate a unique random value of at least 32 UTF-8 bytes and use the same
# value for the API gateway, Auth and Experience & Biodiversity services.
# Never commit the real value.
JWT_SIGNING_KEY=replace-with-a-random-secret-at-least-32-characters

# Generate 32 random bytes and encode as standard padded Base64. Keep any
# trailing '=' and share only with API and Coastal Operations. Never commit it.
COASTAL_OPERATIONS_CONTEXT_KEY=

POSTGRES_DB=blueverse
POSTGRES_USER=blueverse
POSTGRES_PASSWORD=change-me-local

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-local-admin-password

# Docker-internal destinations used by the API reverse proxy and component services (port 8080 in docker network).
AUTH_SERVICE_URL=http://auth:8080
COASTAL_OPERATIONS_SERVICE_URL=http://coastal-operations:8080
EXPERIENCE_BIODIVERSITY_SERVICE_URL=http://experience-biodiversity:8080
MARINE_SAFETY_SERVICE_URL=http://marine-safety:8080
COASTAL_PLANNER_SERVICE_URL=http://coastal-planner:8080
OPERATIONS_SERVICE_URL=http://coastal-operations:8080
# Planner URL consumed by Coastal Operations; it points to the same private service.
PLANNER_SERVICE_URL=http://coastal-planner:8080

# Optional Member 1-3 peer addresses used only while creating assessments.
# The current route shapes are provisional until shared G00 is accepted.
EXPERIENCE_SERVICE_URL=http://experience-biodiversity:8080

# Auth session policy. Access JWTs are short-lived; session lifetimes are
# absolute and may be overridden only within the documented 1/30-day policy.
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_DEFAULT_SESSION_DAYS=1
AUTH_REMEMBER_ME_SESSION_DAYS=30

# Give newly registered accounts only the Coastal traveller planner role.
# Set false for deployments that require administrator assignment instead.
AUTH_SELF_SERVICE_PLANNER_ACCESS=true

# Private peer contracts. Other member services remain owner-confirmation pending.
EXPERIENCE_CATALOGUE_URL=http://api:8080
MARINE_CONDITIONS_URL=http://api:8080
COASTAL_OPERATIONS_URL=http://api:8080
PUBLIC_API_URL=http://api:8080
# Synthetic local-only IT3091 fake is enabled by `docker compose --profile dev`.
# For a real provider, set its approved private URL/key/version in your local .env.
BIODIVERSITY_ML_URL=http://it3091-fake:8080
BIODIVERSITY_ML_API_KEY=
BIODIVERSITY_ML_ENABLED=true
BIODIVERSITY_ML_MODEL_VERSION=fake-v1
IT3091_FAKE_BEHAVIOR=valid

# Independent internal actor-context secret shared only by API and Marine Safety.
# Generate a different random value of at least 32 UTF-8 bytes. Never commit it.
MARINE_ACTOR_SIGNING_KEY=replace-with-a-different-random-secret-at-least-32-characters
MARINE_SAFETY_HTTP_PORT=8080
MARINE_SAFETY_SERVICE_URL=http://marine-safety:8080
